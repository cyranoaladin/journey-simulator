# Example environment file (NON SECRET)
#
# Production docker-compose uses `.env` on the server, but this repo may block committing dotfiles.
# Use this template to create your `.env` locally / on the server:
#
#   cp env.example .env
#

# --- Backend (mf-back) ---
NODE_ENV=production
PORT=3002
MONGO_URI=mongodb://mfai-mongo:27017/journey

# Secrets (replace in real .env)
JWT_SECRET=replace-with-strong-secret
ADMIN_API_KEY=replace-with-strong-admin-key

# CORS (recommended)
# CORS_ALLOWED_ORIGINS=https://journey.mfai.app,https://mfai.app

# OpenAI / Agents
# OPENAI_API_KEY=sk-...

# RAG
# RAG_SEARCH_URL=http://127.0.0.1:8001/rag/query
# RAG_API_KEY=MoneyFactory_2025_Secure_Token_X9
# RAG_COLLECTION=mfai-knowledge

# Safety switches
# ALLOW_INSECURE_CONNECT_WALLET=false
