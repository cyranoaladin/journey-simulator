# Root environment template for Money Factory AI monorepo
# Copy the relevant sections into each package if they expect a local .env file.
# WARNING: never commit real secrets.

########## Backend (mf-back) ##########
MONGO_URI=mongodb://127.0.0.1:27017/mfai
JWT_SECRET=change-me
PORT=3000
ADMIN_API_KEY=admin-demo-key
RAG_SEARCH_URL=https://rag-api.nexusreussite.academy/rag/query
RAG_INGEST_URL=http://localhost:8000/kb/ingest
RAG_API_KEY=MoneyFactory_2025_Secure_Token_X9
RAG_COLLECTION=mfai-knowledge
RAG_DOMAIN=mfai_web3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5.1
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1500

########## Journey Simulator Frontend (journey-simulator) ##########
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_NOTION_WEBHOOK_URL=https://example.com/notion-webhook
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_API_BASE_URL=http://127.0.0.1:3001
