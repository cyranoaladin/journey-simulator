# Example environment for scripts/deploy.sh
# Copy to .deploy.env and adjust values before running the deployment script.

# --- Core services ---
MONGO_URI="mongodb://127.0.0.1:27017/mfai"
JWT_SECRET="replace-with-strong-secret"
ADMIN_API_KEY="change-me"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mfai?schema=public"
SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# --- Optional tuning ---
BACKEND_PORT=3000
NEXT_PORT=3001
FRONTEND_PORT=5173
RUN_TESTS=false

# Uncomment to override branch/remote on deploy
# BRANCH=main
# REMOTE=origin
