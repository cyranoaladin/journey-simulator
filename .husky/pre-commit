#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔐 Security scan avant commit..."

# 1. Bloquer les fichiers .env
if git diff --cached --name-only | grep -qE '^\.env$|^mf-back\/\.env$|^web\/\.env$|^apps\/api\/\.env$|^apps\/web\/\.env$'; then
  echo "❌ ERREUR : Tentative de commit d'un fichier .env — opération annulée"
  exit 1
fi

# 2. Scanner les patterns de secrets dans les fichiers stagés
SECRETS_PATTERN='sk-[a-zA-Z0-9_-]{20,}|password123|change-me|dev-secret-key|MoneyFactory_2025|une_phrase_secrete'
if git diff --cached --unified=0 | grep -qE "$SECRETS_PATTERN"; then
  echo "❌ ERREUR : Pattern de secret détecté dans les fichiers stagés"
  echo "   Patterns bloqués : sk-*, password123, change-me, dev-secret-key"
  echo "   Utilisez process.env.YOUR_SECRET à la place"
  exit 1
fi

# 3. Bloquer web/minter.json
if git diff --cached --name-only | grep -q 'minter.json'; then
  echo "❌ ERREUR : web/minter.json ne doit jamais être commité (clé privée Solana)"
  exit 1
fi

echo "✅ Scan sécurité OK"
