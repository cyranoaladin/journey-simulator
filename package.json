{
  "name": "money-factory-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Venture Engine on Solana - Monorepo",
  "keywords": [
    "ai",
    "solana",
    "web3",
    "nextjs",
    "agents",
    "startup",
    "venture"
  ],
  "author": "Money Factory AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyranoaladin/journey-simulator.git"
  },
  "homepage": "https://mfai.app",
  "bugs": {
    "url": "https://github.com/cyranoaladin/journey-simulator/issues"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:workspaces",
    "install:workspaces": "npm install --workspaces",
    "dev": "make dev",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "test": "npm run test --workspaces",
    "test:web": "npm run test -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/web",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "db:migrate": "cd apps/web && npx prisma migrate dev",
    "db:generate": "cd apps/web && npx prisma generate",
    "db:seed": "cd apps/web && npx prisma db seed",
    "db:studio": "cd apps/web && npx prisma studio",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up --build",
    "docker:down": "docker-compose down",
    "clean": "make clean",
    "security:audit": "make security",
    "setup": "make setup",
    "preflight": "node tools/system-health.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": ".husky/pre-commit"
    }
  }
}
