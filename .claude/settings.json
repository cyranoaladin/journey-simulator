{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompact": true,
  "permissions": {
    "allow": [
      "Ls",
      "Cat",
      "Rg",
      "Grep",
      "Sed",
      "Awk",
      "Git status",
      "Git diff",
      "Git log"
    ],
    "deny": [
      "**/.env*",
      "**/id_rsa",
      "**/id_ed25519",
      "Rm -rf /",
      "DROP TABLE",
      "TRUNCATE TABLE",
      "Mkfs.*",
      "Dd if=/dev/zero of=*"
    ]
  }
}
