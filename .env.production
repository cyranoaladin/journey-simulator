# Production Environment Variables

# Database
DATABASE_URL=postgresql://app:PASSWORD@postgres:5432/journey

# Redis
REDIS_URL=redis://:PASSWORD@redis:6379

# OpenAI
OPENAI_API_KEY=sk-...
LLM_MODEL_NAME=gpt-5.1
LLM_TEMPERATURE=0.4

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_SECRET_KEY_B64=...

# Ethereum
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/...
ETH_PRIVATE_KEY=0x...

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/...
POLYGON_PRIVATE_KEY=0x...

# Pinecone (RAG)
PINECONE_API_KEY=pc-...
PINECONE_INDEX_NAME=journey

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# Admin
ADMIN_API_KEY=...
MINTER_SECRET_KEY=...
KILL_SWITCH=0

# App
NEXT_PUBLIC_APP_URL=https://journey.mfai.app
NODE_ENV=production
