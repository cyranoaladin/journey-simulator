# ═══════════════════════════════════════════════════════════════
# MONEY FACTORY AI — Variables d'environnement complètes
# Copier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════

# ─── SÉCURITÉ ─────────────────────────────────────────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_API_KEY=
RAG_API_KEY=

# ─── BASE DE DONNÉES ──────────────────────────────────────────
# MongoDB (pour legacy journey-simulator)
MONGO_URI=mongodb://localhost:27017/journey
# PostgreSQL + Prisma (mf-back)
DATABASE_URL=postgresql://mfai:mfai_secure_2024@localhost:5433/mfai_db?schema=public
POSTGRES_DB=prisma
POSTGRES_USER=prisma
POSTGRES_PASSWORD=prisma

# ─── CACHE ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LLM PROVIDERS (multi-modèle avec fallback) ───────────────
# OpenAI - Créer une clé sur https://platform.openai.com/api-keys
# ⚠️  À RÉVOQUER IMMÉDIATEMENT si exposée dans un commit
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Anthropic - https://console.anthropic.com (Phase 2)
ANTHROPIC_API_KEY=
# Google AI - https://aistudio.google.com (Phase 2)
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── SOLANA BLOCKCHAIN ────────────────────────────────────────
SOLANA_CLUSTER=devnet            # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
# ⚠️  MINTER_SECRET_KEY : Ne JAMAIS commiter — régénérer si exposée
# Format: base58 encoded private key ou JSON array [1,2,3...]
MINTER_SECRET_KEY=
# Token $MFAI (à créer sur mainnet - Phase 2)
MFAI_TOKEN_MINT=
# SPL Governance Realm (à créer sur app.realms.today - Phase 3)
MFAI_GOVERNANCE_REALM_PK=

# ─── AUTHENTIFICATION ─────────────────────────────────────────
# Secret pour SIWS (Sign In With Solana)
SIWS_JWT_SECRET=
SIWS_APP_DOMAIN=mfai.app

# ─── OBSERVABILITÉ AGENTS ─────────────────────────────────────
# LangFuse - https://cloud.langfuse.com (optionnel mais recommandé)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── RAG (Retrieval Augmented Generation) ─────────────────────
RAG_COLLECTION=mfai-knowledge
RAG_SEARCH_URL=https://rag-api.nexusreussite.academy/search
RAG_HEALTH_URL=https://rag-api.nexusreussite.academy/health
RAG_INGEST_URL=http://127.0.0.1:8000/kb/ingest

# ─── TEST ─────────────────────────────────────────────────────
TEST_USER_PASSWORD=      # Mot de passe pour les tests automatisés
SKIP_OPENAI=true         # true = mode mock (pas d'appels LLM réels)
FORCE_REAL_LLM=false     # true = forcer appels réels même en NODE_ENV=test

# ─── FEATURE FLAGS ────────────────────────────────────────────
KILL_SWITCH=0            # 1 = bloquer tous les mints (urgence)
BLINKS_ENABLED=false     # true = activer endpoints Blinks (Phase 2)
PYTH_ENABLED=false       # true = utiliser Pyth Oracle (Phase 2)
LANGFUSE_ENABLED=false   # true = activer tracing LangFuse
SOLANA_AGENT_KIT_ENABLED=false  # true = activer actions on-chain Zyno (Phase 2)

# ─── EXECUTION ────────────────────────────────────────────────
EXECUTION_ENABLED=true
ENABLE_CRON_JOBS=false
