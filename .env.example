# Frontend Configuration

# API Mock Mode - Set to 'false' or '0' to connect to real backend
# Set to 'true' or '1' to use mock data
VITE_API_MOCK=false

# API Base URL - Backend runs on port 3001
VITE_API_URL=http://localhost:3001

# Blockchain Features - Set to 'false' for API-only testing
VITE_ENABLE_ONCHAIN=false
