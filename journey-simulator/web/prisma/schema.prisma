generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  journeys  Journey[]
  achievements Achievement[]
}

model Journey {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("planned")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
}

model Achievement {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model MintLog {
  id         String   @id @default(cuid())
  userId     String?
  spec       Json
  signature  String?
  network    String   @default("devnet")
  createdAt  DateTime @default(now())
}

model Doc {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String?
  embedding Json?
  createdAt DateTime @default(now())
}

model AgentRun {
  id        String   @id @default(cuid())
  kind      String
  input     Json
  output    Json?
  status    String   @default("ok")
  createdAt DateTime @default(now())
}