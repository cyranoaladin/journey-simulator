{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": ["type", "journey_id", "correlation_id", "ts"],
  "properties": {
    "type": { "type": "string", "description": "ex: simulation.requested, simulation.completed, evaluation.completed, reward.mint.requested, reward.mint.confirmed" },
    "journey_id": { "type": "string", "format": "uuid" },
    "steps": { "type": "array", "items": { "type": "object" } },
    "requested_by": { "type": "string", "description": "pubkey ou user id" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "ts": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
