{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journey",
  "type": "object",
  "required": ["id", "owner_pubkey", "title", "steps", "state", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "owner_pubkey": { "type": "string", "minLength": 32 },
    "title": { "type": "string", "minLength": 3 },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/Step" },
      "minItems": 1
    },
    "state": { "type": "string", "enum": ["draft", "running", "completed", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "last_run_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "Step": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "input": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "running", "done", "failed"] },
        "outputs": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
