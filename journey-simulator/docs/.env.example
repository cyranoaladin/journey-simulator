# Consolidated example env (do NOT commit real secrets)

# OpenAI / LLM
OPENAI_API_KEY=sk-REPLACE
LLM_MODEL_NAME=gpt-5.1
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1500

# Solana (dev only example)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
WALLET_KEYPAIR_PATH=$HOME/.config/solana/id.json

# API / Auth
JWT_SECRET_FILE=/run/secrets/jwt
API_BASE_URL=http://localhost:3000/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=true

# Database (pick one)
DATABASE_URL=postgres://user:pass@localhost:5432/mfai
MONGO_URI=mongodb://localhost:27017/mfai
