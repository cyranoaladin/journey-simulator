# Vite frontend environment configuration
# Copy to .env and provide project-specific values
VITE_API_BASE_URL=http://127.0.0.1:3002
VITE_NOTION_WEBHOOK_URL=https://example.com/notion-webhook
VITE_SOLANA_NETWORK=devnet
# Optional: point mint/staking calls to the Next.js portal
VITE_SOLANA_API_BASE_URL=http://127.0.0.1:3001
# Optional: override RPC endpoint instead of using clusterApiUrl
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
