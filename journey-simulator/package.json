{
  "name": "mfai-journey-simulator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:optimized": "tsc && vite build --mode production",
    "analyze": "npm run build -- --mode analyze",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run test",
    "preview": "vite preview",
    "perf:check": "lighthouse http://localhost:3000 --output html --output-path=./reports/performance-report.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:smoke": "playwright test tests/e2e/04-data-validation/request-smoke.spec.ts tests/e2e/03-user-workflows/persona-onboarding.spec.ts --project=chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:full-audit": "playwright test tests/e2e --reporter=html --reporter=list",
    "test:navigation": "playwright test tests/e2e/01-navigation --reporter=list",
    "test:visual": "playwright test tests/e2e/02-visual-regression --reporter=list",
    "test:agents": "playwright test tests/e2e/03-agent-workflows --reporter=list",
    "test:data": "playwright test tests/e2e/04-data-validation --reporter=list",
    "test:ci": "playwright test --reporter=html --reporter=github",
    "test:visual-update": "playwright test tests/e2e/02-visual-regression --update-snapshots",
    "generate:api": "openapi-typescript ../docs/openapi/mf-back.openapi.yaml -o src/api/mf-back-client.ts",
    "generate:phases-table": "node scripts/generate-phases-table.mjs",
    "generate:file-index": "node scripts/generate-file-index.mjs",
    "generate:api-surface": "node scripts/generate-api-surface.mjs",
    "generate:readme": "node scripts/update-readme-autogen.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.24",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/wallet-adapter-torus": "^0.11.32",
    "@solana/web3.js": "^1.98.2",
    "@toruslabs/solana-embed": "^3.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "buffer": "^6.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.0.0",
    "core-js": "^3.45.1",
    "date-fns": "^4.1.0",
    "events": "^3.3.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.0",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "katex": "^0.16.27",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.556.0",
    "mermaid": "^11.12.1",
    "openapi-fetch": "^0.15.0",
    "particles.js": "^2.0.0",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.6.3",
    "sonner": "^2.0.7",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tailwind-merge": "^2.0.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@storybook/addon-essentials": "^8.1.0",
    "@storybook/addon-interactions": "^8.1.0",
    "@storybook/react-vite": "^8.1.0",
    "@storybook/test": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.5",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/coverage-v8": "^4.0.13",
    "@vitest/ui": "^4.0.9",
    "autoprefixer": "^10.4.16",
    "connect-history-api-fallback": "^2.0.0",
    "cypress": "^15.7.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "execa": "^9.6.1",
    "jsdom": "^27.2.0",
    "mongoose": "^9.1.1",
    "openapi-typescript": "^7.10.1",
    "playwright-core": "^1.57.0",
    "postcss": "^8.4.31",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.3.5",
    "typescript": "~5.3.3",
    "vite": "^4.5.14",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.0.9"
  }
}
