    return [
        createStep('Liquidity Analysis', [
            {
                kind: 'text_block',
                id: `${phaseId}-anal`,
                title: 'Capital Requirements',
                body_markdown: `This phase requires active skin-in-the-game.\n\n**Requirement:** Stake **${requiredAmount} MFAI** to unlock the Foundry modules.` 
            },
            {
                kind: 'bonding_curve_block',
                id: `${phaseId}-curve`,
                title: 'MFAI Bonding Curve',
                description: 'Staking curve visualization',
                curveType: 'exponential' as const,
                data: { currentSupply: 5000000, maxSupply: 10000000, reserveRatio: 0.5, basePrice: 1.2 }
            }
        ], [
            { agent_name: 'DeFiAgent', action: 'calculate_apy', reason: 'Current APY: 12.5%', parameters: { apy: 0.125 } },
            { agent_name: 'RiskAgent', action: 'assess_volatility', reason: 'Volatility acceptable for entry.', parameters: {} }
        ], meta),

        createStep('Capital Commitment', [
             {
                kind: 'text_block',
                id: `${phaseId}-instr`,
                title: 'Execute Stake',
                body_markdown: 'Please confirm your transaction via the secure modal.'
            },
            {
                kind: 'mission_block',
                id: `${phaseId}-stake-mission`,
                title: 'Secure Network Position',
                description: `Stake ${requiredAmount} MFAI tokens to proceed.`,
                mission_type: 'staking',
                expected_input_type: 'choice' as const,
                xp_reward: 250
            }
        ], [
            { agent_name: 'Zyno', action: 'await_tx', reason: 'Waiting for signature...', parameters: {} }
        ], meta)
    ];
};

