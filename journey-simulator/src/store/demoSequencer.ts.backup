import { personas } from '../data/personas';
import type { Mode, Tone, JourneyStepResponse, UIBlock, AgentAction } from '../types/uiBlocks';

// --- HELPER: CONTEXT EXTRACTION ---

const getPhaseContext = (personaId: string, phaseId: string) => {
    const persona = personas.find(p => p.id === personaId);
    if (!persona) throw new Error(`Unknown persona: ${personaId}`);

    const phaseIndex = persona.phases.findIndex(p => p.id === phaseId);
    const phase = persona.phases[phaseIndex];

    if (!phase) throw new Error(`Unknown phase: ${phaseId} for persona ${personaId}`);

    return {
        title: phase.title,
        stakingRequired: (phase as any).stakingRequired || 0,
        daoVoteRequired: (phase as any).daoVoteRequired || false,
        isCollaterize: phaseId.includes('collaterize') || phaseIndex === 5,
        isLaunch: phaseId.includes('launch') || phaseId.includes('market') || phaseIndex === 4,
        phaseIndex,
        personaTitle: persona.title
    };
};

const createStep = (
    title: string,
    blocks: UIBlock[],
    actions: AgentAction[],
    meta: any,
    nextStateDelta: number = 50
): JourneyStepResponse => ({
    metadata: {
        ...meta,
        title,
        summary: `Sequence step for ${title}` 
    },
    ui_blocks: blocks,
    agent_actions: actions,
    next_state: {
        phase_id: meta.phase_id,
        completed_missions: [],
        xp_delta: nextStateDelta
    }
});

// --- GENERATORS SPECIFIQUES (HOOKS) ---

const generateOrientationPhase = (phaseId: string, trackId: string, context: any) => {
    const meta = { persona_id: trackId, journey_track: trackId, phase_id: phaseId, mode: 'discovery' as Mode, tone: 'pedagogical' as Tone, language: 'en' as const };

    return [
        createStep('Protocol Handshake', [
            {
                kind: 'text_block',
                id: `${phaseId}-intro`,
                title: `${context.personaTitle} Orientation`,
                body_markdown: `Welcome to the **${context.personaTitle}** track.\n\nZyno has initialized your learning path. We will begin by establishing the cognitive baseline for this role.` 
            },
            {
                kind: 'resource_block',
                id: `${phaseId}-res`,
                title: 'Core Doctrine',
                resources: [
                    { id: 'res-manifesto', label: `${context.personaTitle} Manifesto`, resource_type: 'article' as const, url: '#', agent_owner: 'Zyno' },
                    { id: 'res-map', label: 'Ecosystem Topology', resource_type: 'article' as const, url: '#', agent_owner: 'ArchitectAgent' }
                ]
            }
        ], [
            { agent_name: 'Zyno', action: 'initialize_track', reason: 'User enrolled in track.', parameters: { track: trackId } },
            { agent_name: 'ArchitectAgent', action: 'map_topology', reason: 'Topology visualized.', parameters: {} }
        ], meta),

        createStep('Knowledge Verification', [
            {
                kind: 'mission_block',
                id: `${phaseId}-quiz`,
                title: 'Baseline Check',
                description: 'Confirm understanding of the core principles.',
                mission_type: 'deliverable',
                expected_input_type: 'choice' as const,
                xp_reward: 100
            }
        ], [
            { agent_name: 'Zyno', action: 'verify_knowledge', reason: 'Baseline established.', parameters: {} }
        ], meta)
    ];
};

const generateStakingPhase = (phaseId: string, trackId: string, context: { stakingRequired: number; personaTitle: string }) => {
