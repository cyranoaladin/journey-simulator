const generateDebugSequence = (phaseId: string, trackId: string, context: any) => {
    const meta = {
        persona_id: trackId,
        journey_track: trackId,
        phase_id: phaseId,
        mode: 'discovery' as Mode,
        tone: 'pedagogical' as Tone,
        language: 'en' as const
    };

    return [
        createStep('UI Block Validation Suite', [
            // 1. TEXT BLOCK - Rich Markdown
            {
                kind: 'text_block',
                id: `${phaseId}-text`,
                title: 'Debug Mode: Rendering Engine Test',
                body_markdown: `
# Welcome to Debug Mode

This sequence validates the **UIBlocksRenderer** engine.

## Test Objectives
- Verify Markdown rendering (bold, italic, lists)
- Check component isolation
- Validate state management

### Supported Features
1. **Typography**: Headers, paragraphs, emphasis
2. **Lists**: Ordered and unordered
3. **Links**: [Documentation](#) (mock)
4. **Code**: \`inline code\` and blocks

\`\`\`typescript
const test = "Block rendering works!";
console.log(test);
\`\`\`

> **Note**: This is a blockquote for visual validation.

---

Continue to the checklist below to verify interactivity.
                `.trim()
            },

            // 2. CHECKLIST BLOCK - Interactive Tasks
            {
                kind: 'checklist_block',
                id: `${phaseId}-checklist`,
                title: 'Rendering Validation Checklist',
                items: [
                    {
                        label: 'Text block renders with proper Markdown formatting',
                        checked: false
                    },
                    {
                        label: 'Checklist items are interactive (can be toggled)',
                        checked: false
                    }
                ]
            },

            // 3. INDICATOR BLOCK - Data Visualization
            {
                kind: 'indicator_block',
                id: `${phaseId}-indicators`,
                title: 'Component Health Metrics',
                type: 'gauge' as const,
                indicators: [
                    {
                        name: 'Rendering Performance',
                        value: 95,
                        max: 100,
                        color: '#22d3ee' // accent-cyan
                    },
                    {
                        name: 'State Sync',
                        value: 100,
                        max: 100,
                        color: '#10b981' // green
                    },
                    {
                        name: 'Memory Usage',
                        value: 42,
                        max: 100,
                        color: '#fbbf24' // yellow
                    }
                ]
            },

            // 4. MISSION BLOCK - Deliverable Submission
            {
                kind: 'mission_block',
                id: `${phaseId}-mission`,
                title: 'Debug Validation Mission',
                description: 'Confirm that all UI blocks rendered correctly. Submit your validation status below.',
                mission_type: 'deliverable',
                expected_input_type: 'markdown_document' as const,
                xp_reward: 250,
                nft_reward_id: 'debug-validator-badge',
                is_mandatory: true
            }
        ], [
            // Agent Actions (appear in ZynoChat)
            {
                agent_name: 'DebugAgent',
                action: 'initialize_test_suite',
                reason: 'Rendering engine initialized. Monitoring component lifecycle.',
                parameters: { test_mode: 'ui_validation', blocks_count: 4 }
            },
            {
                agent_name: 'Zyno',
                action: 'observe',
                reason: 'All blocks loaded successfully. Proceed with validation checks.',
                parameters: {}
            }
        ], meta, 250)
    ];
};

// --- ROUTEUR PRINCIPAL (CONTEXT AWARE) ---

export const getDemoSequence = (phaseId: string, trackId: string): JourneyStepResponse[] => {
    try {
        // --- DEBUG TRAP (PRIORITY 0 - BYPASS CONTEXT) ---
        if (phaseId === 'debug-ui') {
            console.log('⚡ DEBUG TRAP ACTIVATED: Loading debug sequence');
            return generateDebugSequence(phaseId, trackId, {});
        }

        const context = getPhaseContext(trackId, phaseId);

        console.log(`[DemoSequencer] Routing ${trackId}/${phaseId}:`, {
            phaseIndex: context.phaseIndex,
            stakingRequired: context.stakingRequired,
            daoVoteRequired: context.daoVoteRequired,
            isCollaterize: context.isCollaterize,
            isLaunch: context.isLaunch,
        });


        // ROUTING PAR PRIORITÉ MÉTIER (Business Rules)
        
        // 1. COLLATERIZE (Toujours la dernière phase ou ID spécifique)
        if (context.isCollaterize) {
            return generateCollaterizePhase(phaseId, trackId, context);
        }

        // 2. DAO VOTE (Si le flag est activé dans personas.ts)
        if (context.daoVoteRequired) {
            return generateGovernancePhase(phaseId, trackId, context);
        }

        // 3. STAKING (Si un montant est requis)
        if (context.stakingRequired > 0) {
            return generateStakingPhase(phaseId, trackId, context);
        }

        // 4. LAUNCH (Phases de marché)
        if (context.isLaunch) {
            return generateLaunchPhase(phaseId, trackId, context);
        }

        // 5. ORIENTATION (Phase 1)
        if (context.phaseIndex === 0) {
            return generateOrientationPhase(phaseId, trackId, context);
        }

        // 6. IDENTITY / DESIGN (Par défaut pour Phase 4 si pas d'autre règle)
        if (context.phaseIndex === 3) {
            return generateIdentityPhase(phaseId, trackId, context);
        }

        // FALLBACK: Phase Standard générique (mais typée)
        const meta = { persona_id: trackId, journey_track: trackId, phase_id: phaseId, mode: 'discovery' as Mode, tone: 'pedagogical' as Tone, language: 'en' as const };
        return [
            createStep(`${context.title} - Deep Dive`, [
                { kind: 'text_block', id: `${phaseId}-std`, title: context.title, body_markdown: `Exploring advanced concepts of **${context.title}**.` },
                { kind: 'resource_block', id: `${phaseId}-res`, title: 'Resources', resources: [{ id: 'std-1', label: 'Technical Specification', resource_type: 'article' as const, url: '#', agent_owner: 'Zyno' }] }
            ], [{ agent_name: 'Zyno', action: 'facilitate', reason: 'Guiding session.', parameters: {} }], meta),
            createStep(`${context.title} - Validation`, [
                { kind: 'mission_block', id: `${phaseId}-mission`, title: 'Knowledge Check', description: 'Validate your learning.', mission_type: 'deliverable', expected_input_type: 'choice' as const, xp_reward: 150, nft_reward_id: `${phaseId}-badge` }
            ], [{ agent_name: 'ValidationAgent', action: 'verify', reason: 'Checking...', parameters: {} }], meta)
        ];

    } catch (error) {
        console.error(`[DemoSequencer] Error generating sequence for ${trackId}/${phaseId}`, error);
        // Emergency Fallback
        return [];
    }
};
