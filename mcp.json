      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/docs",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/mf-back",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/web",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/journey-simulator",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/scripts",
        "--allowed-dir",
        "/home/alaeddine/Documents/journey_mfai_back_front/tmp"
      ]
    },
    {
      "name": "git",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repo", "/home/alaeddine/Documents/journey_mfai_back_front"]
    },
    {
      "name": "postgres_ro",
      "transport": "stdio",
