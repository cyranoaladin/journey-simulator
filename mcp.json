{
  "version": 1,
  "servers": [
    {
      "name": "filesystem_ro",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/filesystem-ro.mjs",
        "./docs",
        "./mf-back",
        "./web",
        "./journey-simulator",
        "./scripts",
        "./tmp"
      ]
    },
    {
      "name": "git",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/git-server.mjs",
        "."
      ]
    },
    {
      "name": "postgres_ro",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://mcp_ro:prisma@127.0.0.1:5435/prisma"
      ]
    },
    {
      "name": "fetch",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/fetch-server.mjs"
      ]
    }
  ]
}
