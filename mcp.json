{
  "version": 1,
  "servers": [
    {
      "name": "mfai-repo",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/filesystem-ro.mjs",
        "./journey-simulator",
        "./mf-back",
        "./web",
        "./scripts",
        "./tools"
      ]
    },
    {
      "name": "mfai-git",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/git-server.mjs",
        "."
      ]
    },
    {
      "name": "mfai-postgres_ro_local",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://mcp_ro:prisma@127.0.0.1:5435/prisma"
      ]
    },
    {
      "name": "mfai-fetch",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/fetch-server.mjs"
      ]
    },
    {
      "name": "mfai-docs",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/filesystem-ro.mjs",
        "./docs"
      ]
    },
    {
      "name": "mfai-runtime",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/filesystem-ro.mjs",
        "./docker-compose.prod.yml",
        "./docker-compose.deploy.yml",
        "./docker-compose.yml",
        "./DEPLOY_SERVER.md",
        "./DEPLOYMENT_INSTRUCTIONS.md",
        "./docs/HEALTHCHECK.md",
        "./docs/security/hardening.md",
        "./docs/cicd/rollback.md",
        "./docs/PLATFORM_DEEP_DIVE_FR.md",
        "./docs/ARCHITECTURE.md"
      ]
    },
    {
      "name": "mfai-ops",
      "transport": "stdio",
      "command": "node",
      "args": [
        "./tools/mcp/filesystem-ro.mjs",
        "./docs/MCP_RUNBOOK_FR.md",
        "./docs/cicd",
        "./docs/observability",
        "./scripts",
        "./verify-production.sh",
        "./start_dev.sh"
      ]
    }
  ]
}
