# ===== MFAI Monorepo .gitignore =====

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.pid

# Tests & Coverage
coverage/
test-results/
playwright-report/
blob-report/
artifacts/
cypress/videos/
cypress/screenshots/
*.trace
trace.zip
video.webm

# Debug reports
suprem_audit_*.txt
routes_visited*.txt
e2e_json_counts*.txt
sha256.txt
zero_byte_files.txt
list_tests.txt

# Backups & Dumps
*.tar.gz
*.tar
*.bak
backups/
dump/
tmp/

# Environment
.env
.env.*
!.env.example
!.env.sample
.secrets-backup/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.serena/
.cursor/
.cursorrules
.gemini/
.antigravity/

# Node / Build
node_modules/
dist/
build/
.next/
.next_trash/
.nyc_output/
.cache/
.turbo/

# Database
**/dev.db
**/*.sqlite
prisma/dev.db
prisma/*.db

# Solana secrets
web/minter.json

# Runtime metrics (do not commit)
mf-back/memory/agent_metrics.log.json

# Local reporting
qa-report.md
task.md
**/qa-report.md
**/task.md
**/*qa_report*
**/*task_*
**/*phase*_execution*.log
**/*files_list*.log
data/
node_modules/
