# ═══════════════════════════════════════════════════════════════════════════
# MONEY FACTORY AI — Configuration Environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════════════

# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mfai_db?schema=public

# ─── Sécurité ───────────────────────────────────────────────────────────────
JWT_SECRET=changez-cette-cle-par-une-valeur-aleatoire-de-64-caracteres-hex
ADMIN_API_KEY=cle-admin-pour-routes-protegees

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Solana Blockchain ──────────────────────────────────────────────────────
# devnet | mainnet-beta
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Clé privée du wallet minter (base58 ou JSON array)
# ⚠️ JAMAIS committer cette valeur réelle
MINTER_SECRET_KEY=["REPLACE_WITH_REAL_KEYPAIR_ARRAY"]

# Phase 4 — Token $MFAI
# Obtenu après exécution de scripts/create-mfai-token.ts
MFAI_TOKEN_MINT=

# Phase 4 — SPL Governance Realm
# Obtenu après création sur app.realms.today
MFAI_GOVERNANCE_REALM_PK=

# ─── LLM Providers ──────────────────────────────────────────────────────────
# Au moins une clé est requise pour le fonctionnement des agents
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ─── Observabilité (optionnel mais recommandé) ──────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Feature Flags ──────────────────────────────────────────────────────────
# 1 = bloquer tous les mints/transfers d'urgence
KILL_SWITCH=0

# ─── Redis (optionnel) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Tests ──────────────────────────────────────────────────────────────────
TEST_USER_PASSWORD=test_password_secure_123
