# Exemple (NON SECRET) — variables backend (mf-back)
# Notes:
# - Ne commitez jamais vos secrets réels. Utilisez un fichier .env local / sur serveur.
# - Ce backend sert l'API métier pour journey-simulator (UI).
NODE_ENV=production
PORT=3002

# Database
MONGO_URI=mongodb://127.0.0.1:27017/journey

# Auth / security
JWT_SECRET=change-me-dev-only
ADMIN_API_KEY=change-me-dev-only

# CORS (recommandé en prod) — liste d'origines séparées par des virgules
# Exemple: https://journey.mfai.app,https://mfai.app
# CORS_ALLOWED_ORIGINS=

# OpenAI / Agents
# OPENAI_API_KEY=sk-...

# RAG (naming aligné avec le code: RAG_SEARCH_URL, RAG_API_KEY, RAG_COLLECTION)
# RAG_SEARCH_URL=http://127.0.0.1:8001/rag/query
# RAG_INGEST_URL=http://127.0.0.1:8001/rag/ingest
# RAG_API_KEY=MoneyFactory_2025_Secure_Token_X9
# RAG_COLLECTION=mfai-knowledge
# RAG_DATA_PATH=./data/rag-documents

# LLM Configuration
# LLM_MODEL_NAME=gpt-4o
# LLM_TEMPERATURE=0.4
# LLM_MAX_OUTPUT_TOKENS=1500

# Execution (sécurité - désactivé par défaut en production)
# EXECUTION_ENABLED=false
# REAL_EXECUTION_MODE=shadow
# DEMO_MODE=false

# Kill Switch (sécurité)
# KILL_SWITCH=false
# KILL_SWITCH_SCOPE=REAL_ONLY
