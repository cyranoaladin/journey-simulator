# Exemple (NON SECRET) — variables backend (mf-back)
# ⚠️ Ne commitez jamais vos secrets réels. Utilisez un fichier .env local.

NODE_ENV=development
PORT=3002

# Database
MONGO_URI=mongodb://127.0.0.1:27017/journey

# Auth / security
JWT_SECRET=change-me-dev-only
ADMIN_API_KEY=change-me-dev-only

# OpenAI / LLM (optionnel en dev si vous utilisez demo mocks)
# OPENAI_API_KEY=YOUR_OPENAI_KEY
# LLM_MODEL_NAME=gpt-4o
# LLM_TEMPERATURE=0.4
# LLM_MAX_OUTPUT_TOKENS=1500

# RAG (optionnel - utilise fallback local si non défini)
# RAG_SEARCH_URL=http://127.0.0.1:8001/rag/query
# RAG_INGEST_URL=http://127.0.0.1:8001/rag/ingest
# RAG_API_KEY=YOUR_RAG_API_KEY
# RAG_COLLECTION=mfai-knowledge
# RAG_DATA_PATH=./data/rag-documents

# Execution (sécurité - désactivé par défaut)
# EXECUTION_ENABLED=false
# REAL_EXECUTION_MODE=shadow
# DEMO_MODE=false

# Kill Switch (sécurité)
# KILL_SWITCH=false
# KILL_SWITCH_SCOPE=REAL_ONLY
