# Exemple (NON SECRET) — variables backend (mf-back) pour le DEV local
NODE_ENV=development
PORT=3000

# Database (local docker compose)
MONGO_URI=mongodb://mongo:27017/journey

# Auth / security (dev only)
JWT_SECRET=dev-secret-change-me
ADMIN_API_KEY=dev-admin-key-change-me

# CORS (dev): UI locale + ports courants
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:5173,http://127.0.0.1:5173

# OpenAI / Agents (optionnel en dev si vous utilisez demo mocks)
# OPENAI_API_KEY=YOUR_OPENAI_KEY

# RAG (optionnel - utilise fallback local si non defini)
# RAG_SEARCH_URL=http://127.0.0.1:8001/rag/query
# RAG_INGEST_URL=http://127.0.0.1:8001/rag/ingest
# RAG_API_KEY=changeme-dev-rag-key
# RAG_COLLECTION=mfai-knowledge
# RAG_DATA_PATH=./data/rag-documents

# LLM Configuration (optionnel)
# LLM_MODEL_NAME=gpt-4o
# LLM_TEMPERATURE=0.4
# LLM_MAX_OUTPUT_TOKENS=1500

# Execution (securite - desactive par defaut)
# EXECUTION_ENABLED=false
# REAL_EXECUTION_MODE=shadow
# DEMO_MODE=false
