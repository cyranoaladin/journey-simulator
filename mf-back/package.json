{
  "name": "mf-back",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "test": "npm run build && cross-env NODE_ENV=test SKIP_DB_CONNECTION=true jest --config jest.config.cjs --passWithNoTests --runInBand",
    "test:legacy": "cross-env NODE_ENV=test SKIP_DB_CONNECTION=true jest --runInBand tests",
    "test:coverage": "npm run build && cross-env NODE_ENV=test SKIP_DB_CONNECTION=true jest --config jest.config.cjs --coverage --passWithNoTests --runInBand",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "bs58": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "debug": "^4.3.6",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.0",
    "helmet": "^7.2.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemon": "^3.1.10",
    "object-hash": "^3.0.0",
    "openai": "^6.9.1",
    "pdfkit": "^0.15.2",
    "pino": "^10.1.0",
    "pug": "^3.0.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "prisma": "^5.22.0",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
