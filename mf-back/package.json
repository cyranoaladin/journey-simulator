{
  "name": "mf-back",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node scripts/copy-js-files.js",
    "test": "npm run build && cross-env NODE_ENV=test jest --config jest.config.cjs --runInBand",
    "test:unit": "npm run build && cross-env NODE_ENV=test jest --config jest.config.cjs --testPathPattern=tests/unit --runInBand",
    "test:integration": "npm run build && cross-env NODE_ENV=test jest --config jest.config.cjs --testPathPattern=tests/integration --runInBand",
    "test:e2e": "npm run build && cross-env NODE_ENV=test jest --config jest.config.cjs --testPathPattern=tests/e2e --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --config jest.config.cjs --watch",
    "test:coverage": "npm run build && cross-env NODE_ENV=test jest --config jest.config.cjs --coverage --runInBand",
    "test:legacy": "cross-env NODE_ENV=test SKIP_DB_CONNECTION=true jest --runInBand tests",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "reindex": "npx tsx scripts/reindex-knowledge-base.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@lightprotocol/stateless.js": "^0.20.9",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.4.1",
    "@prisma/client": "^5.22.0",
    "@pythnetwork/price-service-client": "^1.10.0",
    "@solana-agent-kit/plugin-nft": "^2.0.7",
    "@solana-agent-kit/plugin-token": "^2.0.9",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "bs58": "^6.0.0",
    "chromadb": "^3.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "debug": "^4.3.6",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.0",
    "helmet": "^7.2.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.6",
    "lru-cache": "^11.2.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemon": "^3.1.10",
    "object-hash": "^3.0.0",
    "ollama": "^0.6.3",
    "openai": "^6.9.1",
    "pdfkit": "^0.15.2",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "pug": "^3.0.3",
    "solana-agent-kit": "^2.0.10",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mockdate": "^3.0.5",
    "prisma": "^5.22.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
