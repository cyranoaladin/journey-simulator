# Next.js environment (do NOT commit secrets)
# Public RPC endpoint may be exposed to the browser when set as NEXT_PUBLIC_*
NEXT_PUBLIC_SOLANA_RPC_URL=
# Server-side RPC endpoint
SOLANA_RPC_URL=

# Observability (optional)
SENTRY_DSN=
SOLANA_CLUSTER=devnet
# Base58 secret key of a devnet minter (DO NOT COMMIT)
MINTER_SECRET_KEY=

# Web3 Pass Configuration
NEXT_PUBLIC_CANDY_MACHINE_ID=INSERT_CANDY_MACHINE_ID_HERE
NEXT_PUBLIC_PASS_COLLECTION_MINT=INSERT_COLLECTION_MINT_HERE
# Kill switch blocks on-chain execution when set to '1'
KILL_SWITCH=0
# Demo & test modes
DEMO_MODE=true
NEXT_PUBLIC_TEST_MODE=1
# Optional feature flags
ENABLE_UMI_REAL=0
USE_PGVECTOR=0
RATE_LIMIT_PER_MINUTE=60
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mfai?schema=public

# RAG Service
NEXT_PUBLIC_RAG_SEARCH_URL=https://rag-api.nexusreussite.academy/search
NEXT_PUBLIC_RAG_HEALTH_URL=https://rag-api.nexusreussite.academy/health
RAG_SEARCH_URL=https://rag-api.nexusreussite.academy/search
RAG_HEALTH_URL=https://rag-api.nexusreussite.academy/health
RAG_INGEST_URL=https://rag-api.nexusreussite.academy/ingest

# LLM (OpenAI Responses API)
# Backend-only: do NOT expose these in NEXT_PUBLIC_*
OPENAI_API_KEY=
# Optional: override base URL if using a compatible gateway
OPENAI_BASE_URL=https://api.openai.com/v1/responses
# Tuning
LLM_MODEL_NAME=gpt-5.1
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.4

# Admin guard for /admin/* pages
ADMIN_API_KEY=

# Other examples (do not inline secrets)
# HELIUS_API_KEY=
# IA_API_KEY=
