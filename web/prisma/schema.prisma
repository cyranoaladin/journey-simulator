generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  walletAddress   String?            @unique
  xp              Int                @default(0)
  mfaiBalance     Float              @default(0)
  stakedMfai      Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  journeys        Journey[]
  achievements    Achievement[]
  journeyProgress JourneyProgress[]
  submissions     MissionSubmission[]
}

model Journey {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("planned")
  personaId String?
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model MintLog {
  id         String   @id @default(cuid())
  userId     String?
  spec       Json
  signature  String?
  network    String   @default("devnet")
  createdAt  DateTime @default(now())
}

model Doc {
  id        String   @id @default(cuid())
  title     String
  content   String
  tags      String?
  embedding Json?
  createdAt DateTime @default(now())
}

model AgentRun {
  id        String   @id @default(cuid())
  kind      String
  input     Json
  output    Json?
  status    String   @default("ok")
  createdAt DateTime @default(now())
}

model JourneyProgress {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  personaId      String
  currentPhaseId String?
  completedPhases Json    @default("[]")
  progress       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, personaId])
  @@index([userId])
  @@index([personaId])
}

model MissionSubmission {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  personaId   String
  phaseId     String
  missionData Json
  status      String   @default("pending")
  score       Float?
  feedback    String?
  submittedAt DateTime @default(now())
  evaluatedAt DateTime?

  @@index([userId])
  @@index([personaId, phaseId])
  @@index([status])
}

model JourneyState {
  id           String   @id @default(cuid())
  journeyId    String   @unique
  last_state   Json
  last_metadata Json?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model AgentLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  journeyId String?
  userId    String?
  agent     String
  action    String
  details   Json?
  @@index([journeyId, ts])
  @@index([userId, ts])
}
