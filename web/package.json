{
  "name": "journey-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/run-prisma-generate.js",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --coverage",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "verify": "npm run lint && npm run build && npm run test:unit && npm run test:e2e",
    "migrate:deploy": "prisma migrate deploy",
    "reset:demo": "ts-node scripts/reset-demo.ts",
    "openapi:rapidoc": "npx http-server ../docs/openapi -p 8089 -o /preview.html",
    "openapi:redoc": "npx redoc-cli serve ../docs/openapi/journey-simulator.yaml -p 8088",
    "postinstall": "next telemetry disable || true"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "^3.3.0",
    "@metaplex-foundation/umi": "^1.4.1",
    "@prisma/client": "5.20.0",
    "@sentry/nextjs": "^10.42.0",
    "@solana/wallet-adapter-base": "^0.9.24",
    "@solana/wallet-adapter-phantom": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "next": "^16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^5.10.0",
    "swagger-ui-react": "^5.17.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "20.11.30",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.14",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.13",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "undici": "^7.16.0"
  }
}
